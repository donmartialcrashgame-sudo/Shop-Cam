  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/images/shop-1.jpg",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any maskable"
    },
    {
      "src": "/images/shop-2.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My Orders",
      "short_name": "Orders",
      "url": "/orders.html",
      "icons": [{"src": "/images/shop-1.jpg", "sizes": "192x192", "type": "image/jpeg"}]
    },
    {
      "name": "Notifications",
      "short_name": "Notifications",
      "url": "/notifications.html",
      "icons": [{"src": "/images/shop-2.jpg", "sizes": "192x192", "type": "image/jpeg"}]
    },
    {
      "name": "Shopping Cart",
      "short_name": "Cart",
      "url": "/cart.html",
      "icons": [{"src": "/images/shop-1.jpg", "sizes": "192x192", "type": "image/jpeg"}]
    }
  ]
}
